# Koneksi PostgreSQL (Neon/Lakebase Postgres).
# DATABASE_URL = koneksi pooled untuk aplikasi (host berakhiran -pooler).
# DATABASE_URL_UNPOOLED = koneksi langsung untuk migrasi/drizzle-kit.
# Keduanya diisi otomatis oleh `neon deploy` / `neon env pull`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"
# Set true untuk database terkelola yang mewajibkan SSL (mis. Neon).
DB_SSL=true

# Better Auth (dikelola aplikasi sendiri; Neon Auth tidak dipakai untuk login).
BETTER_AUTH_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"

# Jalankan migrasi otomatis saat server start (nyaman untuk dev).
DB_AUTO_MIGRATE=true

# Neon Auth (disediakan `neon deploy`, belum dipakai kode aplikasi).
# NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.aws.neon.tech/neondb/auth"
# NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.aws.neon.tech/neondb/auth/.well-known/jwks.json"
