# Koneksi PostgreSQL. Ganti ke Neon/penyedia lain di produksi.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/db_yplk_pembayaran"
# Set true untuk database terkelola yang mewajibkan SSL (mis. Neon).
DB_SSL=false

# Better Auth
BETTER_AUTH_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"

# Jalankan migrasi otomatis saat server start (nyaman untuk dev).
DB_AUTO_MIGRATE=true
